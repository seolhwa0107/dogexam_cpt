[{"id":"trim-001","cat":"trim","term":"그루머 (groomer)","en":"","defn":"애완동물 미용사. 동물의 피모 관리를 전문적으로 하는 사람으로 트리머(trimmer)라고 부르기도 함.","chapter":"1"},{"id":"trim-002","cat":"trim","term":"그루밍 (grooming)","en":"","defn":"피모에 대한 일상적인 손질을 모두 포함하는 포괄적인 것. 몸을 청결하게 하고 건강하게 하기 위한 브러싱, 베이싱, 코밍, 트리밍 등의 피모에 대한 모든 작업을 포함","chapter":"1"},{"id":"trim-003","cat":"trim","term":"그리핑 (gripping)","en":"","defn":"트리밍 나이프로 소량의 털을 골라 뽑는 것.","chapter":"1"},{"id":"trim-004","cat":"trim","term":"네일 트리밍 (nail trimming)","en":"","defn":"발톱 손질.","chapter":"1"},{"id":"trim-005","cat":"trim","term":"듀플렉스 쇼튼 (duplex-shorten)","en":"","defn":"듀플렉스 트리밍(duplex trimming) 스트리핑 후 일정 기간 새 털이 자라날 때까지 들뜬 오래된 털을 다시 뽑는 것.","chapter":"1"},{"id":"trim-006","cat":"trim","term":"드라잉 (drying)","en":"","defn":"드라이어로 코트를 말리는 과정. 모질이나 품종의 스탠더드에 따라 여러 가지 드라이 방법을 달리 활용할 수 있음","chapter":"1"},{"id":"trim-007","cat":"trim","term":"래핑 (wrapping)","en":"","defn":"장모종의 긴 털을 보호하기 위해 적당한 양의 털을 나누어 래핑지로 감싸주는 작업. 동물의 보행에 불편함이 없어야 하며 털을 보호할 수 있도록 해야 함.","chapter":"1"},{"id":"trim-008","cat":"trim","term":"레이저 커트 (razor cut)","en":"","defn":"면도날로 털을 잘라 내는 것.","chapter":"1"},{"id":"trim-009","cat":"trim","term":"레이킹 (raking)","en":"","defn":"스트리핑 후 남은 오버코트나 언더코트를 일정 간격으로 제거해 주는 것.","chapter":"1"},{"id":"trim-010","cat":"trim","term":"린싱 (rinsing)","en":"","defn":"샴푸 후 린스를 뿌려 코트를 마사지하고 헹구어 내는 작업. 털을 부드럽게 하여 정전기를 방지하고 샴푸로 인한 알칼리 성분을 중화하는 작업","chapter":"1"},{"id":"trim-011","cat":"trim","term":"밥 커트 (bob cut)","en":"","defn":"털을 가위로 잘라 일직선으로 가지런히 하는 것","chapter":"1"},{"id":"trim-012","cat":"trim","term":"밴드 (band)","en":"","defn":"띠 모양으로 형태를 잡아 깎아 들어간 부분.","chapter":"1"},{"id":"trim-013","cat":"trim","term":"베이싱 (bathing)","en":"","defn":"목욕. 입욕. 물로 코트를 적셔 샴푸로 세척하고 충분히 헹구어 내는 작업.","chapter":"1"},{"id":"trim-014","cat":"trim","term":"브러싱 (brushing)","en":"","defn":"브러시를 이용하여 빗질하는 것. 피부를 자극하여 마사지 효과를 주고 노폐모와 탈락모를 제거함. 피부의 혈액 순환을 좋게 하고 신진대사를 촉진하여 건강한 피모가 되도록 함. 엉킨 털 뭉치를 제거하고 피모를 청결하게 함","chapter":"1"},{"id":"trim-015","cat":"trim","term":"블렌딩 (blending)","en":"","defn":"털의 길이가 다른 곳의 층을 연결하여 자연스럽게 하는 것","chapter":"1"},{"id":"trim-016","cat":"trim","term":"블로 드라잉 (blow drying)","en":"","defn":"드라이어를 사용하여 코트를 말리는 작업","chapter":"1"},{"id":"trim-017","cat":"trim","term":"새킹 (sacking)","en":"","defn":"베이싱 후 털이 튀어나오거나 뜨는 것을 막아 가지런히 하기 위해 신체를 타월로 싸 놓는 것.","chapter":"1"},{"id":"trim-018","cat":"trim","term":"샴핑 (shampooing)","en":"","defn":"샴푸를 이용하여 씻기는 것. 몸을 따뜻한 물로 적시고 손가락으로 마사지 하여 세척한 후 헹구어 내는 작업","chapter":"1"},{"id":"trim-019","cat":"trim","term":"세트 스프레이 (set spray)","en":"","defn":"톱 노트 부분의 코트를 세우기 위해 스프레이 등을 뿌리는 작업","chapter":"1"},{"id":"trim-020","cat":"trim","term":"세트업 (set up)","en":"","defn":"톱 노트를 형성시키기 위해 두부의 코트를 밴딩하고 세트 스프레이를 하는 작업.","chapter":"1"},{"id":"trim-021","cat":"trim","term":"셰이빙 (shaving)","en":"","defn":"드레서나 나이프를 이용하여 털을 베듯이 자르는 기법","chapter":"1"},{"id":"trim-022","cat":"trim","term":"쇼 클립 (show clip)","en":"","defn":"쇼에 출진하기 위한 그루밍으로 쇼에서 요구하는 타입의 미용 스타일을 완성해야 함. 보통 각 견종의 표준에 맞는 그루밍 방법이 정해져 있으며, 출진할 시기에 맞추어 출진 견이 최고의 상태로 돋보일 수 있도록 쇼 당일에 초점을 맞추어 계획적으로 피모를 정돈해 두어야 함.","chapter":"1"},{"id":"trim-023","cat":"trim","term":"스웰 (swell)","en":"","defn":"두부를 부풀려 볼륨 있게 모양을 낸 것","chapter":"1"},{"id":"trim-024","cat":"trim","term":"스테이징 (staging)","en":"","defn":"미니어처슈나우저 등에게 하는 스트리핑 방법의 순서","chapter":"1"},{"id":"trim-025","cat":"trim","term":"스트리핑 (stripping)","en":"","defn":"트리밍 나이프를 사용해 노폐물 및 탈락된 언더코트를 제거하거나 과도한 언더코트 양을 줄이기 위해 털을 뽑아 스타일을 만들어 내는 미용 방법.","chapter":"1"},{"id":"trim-026","cat":"trim","term":"스펀징 (sponging)","en":"","defn":"샴핑할 때 스펀지를 이용하는 것","chapter":"1"},{"id":"trim-027","cat":"trim","term":"시닝 (thinning)","en":"","defn":"빗살 가위로 과도하게 많은 부분의 털을 잘라 내어 모량을 감소시키고 형태를 만드는 것.","chapter":"1"},{"id":"trim-028","cat":"trim","term":"시저링 (scissoring)","en":"","defn":"가위로 털을 잘라 내는 것.","chapter":"1"},{"id":"trim-029","cat":"trim","term":"오일 브러싱 (oil brushing)","en":"","defn":"피모에 오일을 발라 브러싱하는 것.","chapter":"1"},{"id":"trim-030","cat":"trim","term":"이미지너리 라인 (imaginary line)","en":"","defn":"외부에 설정하는 가상의 선.","chapter":"1"},{"id":"trim-031","cat":"trim","term":"인덴테이션 (indentation)","en":"","defn":"우묵한 패임을 만드는 것. 푸들의 스톱에 역방형 표현.","chapter":"1"},{"id":"trim-032","cat":"trim","term":"초킹 (chalking)","en":"","defn":"냄새나 더러움을 제거하기 위해 흰색 털에 흰색을 표현할 수 있는 제품을 문질러 바르는 것","chapter":"1"},{"id":"trim-033","cat":"trim","term":"치핑 (chipping)","en":"","defn":"가위나 빗살 가위를 사용하여 털끝을 잘라 내는 미용 방법","chapter":"1"},{"id":"trim-034","cat":"trim","term":"카딩 (carding)","en":"","defn":"빗질하거나 긁어내어 털을 제거하는 미용 방법","chapter":"1"},{"id":"trim-035","cat":"trim","term":"커팅 (cutting)","en":"","defn":"가위나 클리퍼로 털을 잘라 원하는 형태를 만들어 내는 것","chapter":"1"},{"id":"trim-036","cat":"trim","term":"코밍 (combing)","en":"","defn":"털을 가지런하게 빗질하는 것. 보통 털의 방향으로 일정하게 정리하는 것이 기본적인 의미임","chapter":"1"},{"id":"trim-037","cat":"trim","term":"클리핑 (clipping)","en":"","defn":"클리퍼를 사용하여 스타일 완성에 불필요한 털을 잘라 내는 것","chapter":"1"},{"id":"trim-038","cat":"trim","term":"타월링 (toweling)","en":"","defn":"베이싱 후 타월을 감싸 닦아 내는 것","chapter":"1"},{"id":"trim-039","cat":"trim","term":"토핑오프 (topping-off)","en":"","defn":"스트리핑 후 완성된 아웃코트 위에 튀어나오는 털을 뽑아 정리하는 것.","chapter":"1"},{"id":"trim-040","cat":"trim","term":"트리밍 (trimming)","en":"","defn":"털을 자르거나 뽑거나 미는 등의 모든 미용 작업을 일컫는 말. 불필요한 부분의 털을 제거하여 스타일을 만듦.","chapter":"1"},{"id":"trim-041","cat":"trim","term":"파팅 (parting)","en":"","defn":"털을 좌우로 분리시키는 것. 분리한 선은 파팅 라인이라고 함.","chapter":"1"},{"id":"trim-042","cat":"trim","term":"페이킹 (faking)","en":"","defn":"눈속임. 여러 기법으로 모색 및 모질에 대한 눈속임을 하는 것","chapter":"1"},{"id":"trim-043","cat":"trim","term":"펫 클립 (pet clip)","en":"","defn":"쇼 클립을 제외한 나머지 미용을 대부분 펫 클립이라고 함. 가정에서 애완견으로 키우기 위하여 털을 청결하게 관리해 건강을 유지할 수 있 어야 하며, 견종에 따른 피모의 특성, 생활 환경, 개체의 성격과 보호자 의 생활 방식이나 취향 등을 고려하여 다양한 스타일을 연출함.","chapter":"1"},{"id":"trim-044","cat":"trim","term":"플러킹 (plucking)","en":"","defn":"트리밍 칼로 털을 뽑아 원하는 미용 스타일을 만드는 것","chapter":"1"},{"id":"trim-045","cat":"trim","term":"피킹 (picking)","en":"","defn":"- 듀플렉스 쇼트와 같은 작업, - 주로 손가락을 사용하여 오래된 털을 정리함.","chapter":"1"},{"id":"trim-046","cat":"trim","term":"핑거 앤드 섬 워크 (finger and thumb work)","en":"","defn":"- 엄지손가락과 집게손가락을 이용해 털을 제거하는 것. 기구로 하는 방법보다 자연스러운 표현이 가능","chapter":"1"},{"id":"trim-047","cat":"trim","term":"화이트닝 (whitening)","en":"","defn":"견체의 하얀 털 부분을 더욱 하얗게 보이게 하기 위한 작업.","chapter":"1"},{"id":"coat-048","cat":"coat","term":"더블 코트 (double coat)","en":"","defn":"오버코트와 언더코트의 이중모 구조의 털. 예) 콜리","chapter":"2"},{"id":"coat-049","cat":"coat","term":"러프 (ruff)","en":"","defn":"목 주위의 풍부한 장식 털.","chapter":"2"},{"id":"coat-050","cat":"coat","term":"롱 코트 (long coat)","en":"","defn":"장모(長毛), 긴 털","chapter":"2"},{"id":"coat-051","cat":"coat","term":"머스태시 (moustache)","en":"","defn":"입술과 턱 측면에 난 수염","chapter":"2"},{"id":"coat-052","cat":"coat","term":"머즐 밴드 (muzzle band)","en":"","defn":"주둥이 주위의 하얀 반점.","chapter":"2"},{"id":"coat-053","cat":"coat","term":"메인 코트 (main coat)","en":"","defn":"몸의 중심이 되는 털.","chapter":"2"},{"id":"coat-054","cat":"coat","term":"몰팅 (molting)","en":"","defn":"자연스러운 계절적인 환모","chapter":"2"},{"id":"coat-055","cat":"coat","term":"블론 (blown)","en":"","defn":"환모기의 털","chapter":"2"},{"id":"coat-056","cat":"coat","term":"비어드 (beard)","en":"","defn":"입 주위의 털","chapter":"2"},{"id":"coat-057","cat":"coat","term":"새들 (saddle)","en":"","defn":"등 부분에 넓은 안장 같은 반점","chapter":"2"},{"id":"coat-058","cat":"coat","term":"섀기 (shaggy)","en":"","defn":"올드잉글리시 십독과 같은 덥수룩한 털.","chapter":"2"},{"id":"coat-059","cat":"coat","term":"스무드 코트 (smooth coat)","en":"","defn":"단모(短毛), 짧은 털.","chapter":"2"},{"id":"coat-060","cat":"coat","term":"스커트 (skirt)","en":"","defn":"에이프런 아랫부분의 긴 장식 털","chapter":"2"},{"id":"coat-061","cat":"coat","term":"스탠드 오프 코트 (stand off coat)","en":"","defn":"개립모(開立毛), 꼿꼿하게 선 모양의 털. 예) 스피츠, 포메라니안","chapter":"2"},{"id":"coat-062","cat":"coat","term":"스테이링 코트 (staring coat)","en":"","defn":"건조하고 거칠며 상태가 나빠진 털, 질병이 있거나 영양 상태가 안 좋을 경우 나타남.","chapter":"2"},{"id":"coat-063","cat":"coat","term":"스트레이트 코트 (straight coat)","en":"","defn":"직립모(直立毛). 털이 구불거리지 않는 직선의 털","chapter":"2"},{"id":"coat-064","cat":"coat","term":"실키 코트 (silky coat)","en":"","defn":"부드럽고 광택이 있는 실크 같은 긴 모질.","chapter":"2"},{"id":"coat-065","cat":"coat","term":"싱글 코트 (single coat)","en":"","defn":"한 겹의 털","chapter":"2"},{"id":"coat-066","cat":"coat","term":"아웃 오브 코트 (out of coat)","en":"","defn":"모량이 부족하거나 탈모된 상태","chapter":"2"},{"id":"coat-067","cat":"coat","term":"아이래시 (eyelash)","en":"","defn":"속눈썹","chapter":"2"},{"id":"coat-068","cat":"coat","term":"아이브로 (eyebrow)","en":"","defn":"눈썹 부위의 털","chapter":"2"},{"id":"coat-069","cat":"coat","term":"언더코트 (undercoat)","en":"","defn":"아래 털, 하모(下毛), 부모(副毛), 체온을 유지하고 조절하거나 방수성을 가짐. 부드럽고 촘촘하게 나 있음.","chapter":"2"},{"id":"coat-070","cat":"coat","term":"에이프런 (apron)","en":"","defn":"가슴 부위의 장식 털.","chapter":"2"},{"id":"coat-071","cat":"coat","term":"역모","en":"","defn":"털 결에서 반대로 자란 털, 주로 목이나 항문에 있음","chapter":"2"},{"id":"coat-072","cat":"coat","term":"오버코트 (overcoat)","en":"","defn":"위 털, 상모(上毛), 주모(主毛), 외부 환경으로부터 신체를 보호함. 언더코트보다 굵고 긺.","chapter":"2"},{"id":"coat-073","cat":"coat","term":"와이어 코트 (wire coat)","en":"","defn":"뻣뻣하고 강한 형태의 모질, 상모가 단단하고 바삭거리는 모질.","chapter":"2"},{"id":"coat-074","cat":"coat","term":"울리 코트 (woolly coat)","en":"","defn":"양모상의 털, 북방 견종에게 많음. 워터도그의 코트에는 방수 효과가 있음.","chapter":"2"},{"id":"coat-075","cat":"coat","term":"웨이비 코트 (wavy coat)","en":"","defn":"파상모(波狀毛), 상모에 웨이브가 있는 털.","chapter":"2"},{"id":"coat-076","cat":"coat","term":"위스커 (whisker)","en":"","defn":"주둥이 볼 양쪽과 아래턱의 길고 단단한 털. 예) 미니어처슈나우저","chapter":"2"},{"id":"coat-077","cat":"coat","term":"컬리 코트 (curly coat)","en":"","defn":"권모(捲毛), 곱슬 모","chapter":"2"},{"id":"coat-078","cat":"coat","term":"코디드 코트 (corded coat)","en":"","defn":"승상모(繩狀毛), 로프 코트(rope coat) 새끼줄 모양으로 된 털. 언더코트와 오버코트가 자연스럽게 얽혀 새끼줄 모양으로 된 털. 예) 코몬도르, 풀리","chapter":"2"},{"id":"coat-079","cat":"coat","term":"코트 (coat)","en":"","defn":"털, 외부 온도 변화와 외상으로부터 피부를 보호한다. 품종에 따라 모색, 강도, 털의 성질이 다양함.","chapter":"2"},{"id":"coat-080","cat":"coat","term":"컬로트 (culotte)","en":"","defn":"뒷다리의 긴 장식 털","chapter":"2"},{"id":"coat-081","cat":"coat","term":"타셀 (tassel)","en":"","defn":"귀 끝에 남긴 장식 털. 예) 베들링턴테리어","chapter":"2"},{"id":"coat-082","cat":"coat","term":"톱 노트 (top knot)","en":"","defn":"정수리 부분의 긴 장식 털.","chapter":"2"},{"id":"coat-083","cat":"coat","term":"트라우저스 (trousers)","en":"","defn":"다량의 긴 털이 뒷다리에 자라난 헐렁헐렁한 판탈롱. 예) 아프간하운드","chapter":"2"},{"id":"coat-084","cat":"coat","term":"팁 (tip)","en":"","defn":"꼬리 끝의 하얀색 털.","chapter":"2"},{"id":"coat-085","cat":"coat","term":"파일 (pile)","en":"","defn":"두껍고 많은 언더코트","chapter":"2"},{"id":"coat-086","cat":"coat","term":"페더링 (feathering)","en":"","defn":"프린지(fringe), 귀•다리꼬리•몸통 등에 있는 깃털 모양의 장식 털","chapter":"2"},{"id":"coat-087","cat":"coat","term":"페서헤어 (festher-hair)","en":"","defn":"스코티시테리어의 머리, 귀 주변에 남겨진 장식 털","chapter":"2"},{"id":"coat-088","cat":"coat","term":"펠트 (felt)","en":"","defn":"털이 엉켜 굳은 상태.","chapter":"2"},{"id":"coat-089","cat":"coat","term":"폴 (fall)","en":"","defn":"정수리에서 안면부로 늘어져 내린 털. 예) 아프간하운드, 스카이테리어","chapter":"2"},{"id":"coat-090","cat":"coat","term":"프릴 (frill)","en":"","defn":"목 아래와 가슴의 길고 풍부한 털. 예) 러프콜리","chapter":"2"},{"id":"coat-091","cat":"coat","term":"플럼 (plume)","en":"","defn":"깃발 모양 꼬리의 장식 털. 예) 잉글리시세터","chapter":"2"},{"id":"coat-092","cat":"coat","term":"피부 (skin)","en":"","defn":"외부 병원체로부터 신체를 보호하는 촉각. 온각, 냉각, 통각, 압각 등의 감각 기관.","chapter":"2"},{"id":"coat-093","cat":"coat","term":"하시 코트 (harsh coat)","en":"","defn":"거치고 단단한 와이어 코트","chapter":"2"},{"id":"color-094","cat":"color","term":"골드 버프 (golden buff)","en":"","defn":"금색에 빨강이 있는 담황색","chapter":"3"},{"id":"color-095","cat":"color","term":"골드 (gold)","en":"","defn":"황금색.","chapter":"3"},{"id":"color-096","cat":"color","term":"그레이 (gray)","en":"","defn":"회색. 어두운 회색부터 밝은 색까지 다양한 색이 있음","chapter":"3"},{"id":"color-097","cat":"color","term":"그루즐 (gruzzle)","en":"","defn":"흑색 계통 털에 회색이나 적색이 섞인 색","chapter":"3"},{"id":"color-098","cat":"color","term":"대플 (dapple)","en":"","defn":"특별히 도드라지는 색 없이 여러 가지 색으로 반점을 만드는 색. 불규칙한 반점.","chapter":"3"},{"id":"color-099","cat":"color","term":"데드 그래스 (dead grass)","en":"","defn":"엷은 다갈색으로 마른 풀색, 데드 리프라고도 함","chapter":"3"},{"id":"color-100","cat":"color","term":"러스트 탠 (rust tan)","en":"","defn":"녹슨 색의 탠","chapter":"3"},{"id":"color-101","cat":"color","term":"레드 (red)","en":"","defn":"마른 나뭇잎 색, 황갈색. 적색","chapter":"3"},{"id":"color-102","cat":"color","term":"레몬 (lemon)","en":"","defn":"레몬색.","chapter":"3"},{"id":"color-103","cat":"color","term":"론 (roan)","en":"","defn":"흰색 털과 유색의 털이 섞여 있는 것. 검은 바탕에 흰색의 털이 섞인 것. 유색모의 색상에 따라 블루론(blue roan), 오렌지 론(orange roan), 레몬 론(lemon roan), 리버 론(liver roan), 레드 론(red roan) 등이 있음","chapter":"3"},{"id":"color-104","cat":"color","term":"루비 (ruby)","en":"","defn":"진한 밤색","chapter":"3"},{"id":"color-105","cat":"color","term":"리버 (liver)","en":"","defn":"진한 적갈색, 붉은 간장 색.","chapter":"3"},{"id":"color-106","cat":"color","term":"마스크 (mask)","en":"","defn":"이마, 주둥이 부위가 검은 것으로 블랙 마스크라고 함. 예) 마스티프, 복서, 페키니즈","chapter":"3"},{"id":"color-107","cat":"color","term":"마우스 그레이 (mouse gray)","en":"","defn":"쥐색.","chapter":"3"},{"id":"color-108","cat":"color","term":"마킹 (marking)","en":"","defn":"반점. 부위에 따라 분포와 크기가 다양함","chapter":"3"},{"id":"color-109","cat":"color","term":"마호가니 (mahogany)","en":"","defn":"체스트너트 레드, 적갈색","chapter":"3"},{"id":"color-110","cat":"color","term":"맨틀 (mantle)","en":"","defn":"어깨, 등, 몸통 양쪽에 망토를 걸친 듯한 크고 진한 반점이 있는 것. 예) 세인트버나드","chapter":"3"},{"id":"color-111","cat":"color","term":"머스터드 (mustard)","en":"","defn":"겨자색, 황색","chapter":"3"},{"id":"color-112a","cat":"color","term":"머즐 밴드 (muzzle band)","en":"","defn":"주둥이 주위에 흰색 반점. 예) 보스턴테리어, 세인트버나드","chapter":"3"},{"id":"color-112","cat":"color","term":"멀 (merle)","en":"","defn":"검정, 블루, 그레이의 배색.","chapter":"3"},{"id":"color-113","cat":"color","term":"배저 마킹 (badger marking)","en":"","defn":"목, 귀에 탄이나 다른 색의 반점이 있는 것. 그레이, 진회색, 화이트가 섞인 오소리 색 반점.","chapter":"3"},{"id":"color-114","cat":"color","term":"배저 (badger)","en":"","defn":"그레이, 진회색, 화이트가 섞인 모색.","chapter":"3"},{"id":"color-115","cat":"color","term":"버프 (buff)","en":"","defn":"부드럽고 연한 느낌의 담황색","chapter":"3"},{"id":"color-116","cat":"color","term":"벨튼 (belton)","en":"","defn":"흰색 바탕에 옅은 반점이 흩어져 있는 것. 모색에 따라 블루 벨튼, 오렌지 벨튼, 리버 벨튼, 레몬 벨튼 등이 있음.","chapter":"3"},{"id":"color-117","cat":"color","term":"브라운 (brown)","en":"","defn":"갈색, 다갈색","chapter":"3"},{"id":"color-118","cat":"color","term":"브로큰 컬러 (broken color)","en":"","defn":"단일색인 모색이 파괴된 것","chapter":"3"},{"id":"color-119","cat":"color","term":"브론즈 (bronze)","en":"","defn":"전체적으로 어두운 녹색에 털끝이 약간 붉은 색.","chapter":"3"},{"id":"color-120","cat":"color","term":"브리칭 (breeching)","en":"","defn":"검은색 개의 대퇴부 안쪽과 후방의 탠 반점 예) 맨체스터테리어, 로트와일러","chapter":"3"},{"id":"color-121","cat":"color","term":"브린들 (brindle)","en":"","defn":"바탕색에 다른 색의 무늬가 존재하는 털. 어두운 바탕색에 밝은 모색이 섞이거나 밝은 바탕색에 어두운 모색이 섞인 것. 예) 스코티시테리어, 적색이나 황색 바탕에 검정 또는 어두운 색의 줄무늬를 만든 것을 타이거 브린들이라고 함. 예) 그레이트데인","chapter":"3"},{"id":"color-122","cat":"color","term":"블랙 마스크 (black mask)","en":"","defn":"주둥이 부분이 검은 것.","chapter":"3"},{"id":"color-123","cat":"color","term":"블랙 앤드 탠 (black and tan)","en":"","defn":"검은 바탕에 양 눈 위, 귀 안쪽, 주둥이 양측, 목, 아랫다리, 항문 주 위에 탠이 있는 것.","chapter":"3"},{"id":"color-124","cat":"color","term":"블랭킷 (blanket)","en":"","defn":"목, 꼬리 사이의 등, 몸통 쪽에 넓게 있는 모색. 예) 아메리칸폭스하운드","chapter":"3"},{"id":"color-125","cat":"color","term":"블레이즈 (blaze)","en":"","defn":"양 눈과 눈 사이에 중앙을 가르는 가늘고 긴 백색의 선. 예) 파피용","chapter":"3"},{"id":"color-126","cat":"color","term":"블루 마블 (blue marble)","en":"","defn":"블루멀(blue merle). 검정, 블루, 그레이가 섞인 대리석 색.","chapter":"3"},{"id":"color-127","cat":"color","term":"블루 블랙 (blue black)","en":"","defn":"블루에 털끝이 검은 털","chapter":"3"},{"id":"color-128","cat":"color","term":"블루 (blue)","en":"","defn":"검은 것 같은 청색으로 농도의 폭이 넓음. 보통 태어날 때는 검은색이나 성장하며 블루로 변함","chapter":"3"},{"id":"color-129","cat":"color","term":"비버 (beaver)","en":"","defn":"브라운과 그레이가 섞인 색","chapter":"3"},{"id":"color-130","cat":"color","term":"삭스 (socks)","en":"","defn":"유색 견이 흰색 양말을 신은 것 같은 무늬. 예)이비전하운드","chapter":"3"},{"id":"color-131","cat":"color","term":"새들 (saddle)","en":"","defn":"말안장을 얹은 것 같은 검은색 반점. 예)에어데일테리어","chapter":"3"},{"id":"color-132","cat":"color","term":"샌드 (sand)","en":"","defn":"모래색","chapter":"3"},{"id":"color-133","cat":"color","term":"설반 (舌班)","en":"","defn":"반점이 있는 혀. 예) 차우차우","chapter":"3"},{"id":"color-134","cat":"color","term":"섬 마크 (thumb mark)","en":"","defn":"패스턴에서 볼 수 있는 검은색 반점. 예) 맨체스터테리어, 토이 맨체스터테리어","chapter":"3"},{"id":"color-135","cat":"color","term":"세이블 (sable)","en":"","defn":"연한 기본 모색에 검은색 털이 섞여 있거나 겹쳐 있는 것. 황색 또는 황갈색 바탕에 털끝이 검은색. 오렌지색 바탕에 세이블은 오렌지 세이블, 암갈색 바탕에 세이블이 겹쳐진 것은 다크 세이블이라고 함","chapter":"3"},{"id":"color-136","cat":"color","term":"셀프 마크드 (self marked)","en":"","defn":"가슴, 발가락, 꼬리 끝에 흰색이나 청색 반점을 가진 한 가지 색으로 보통은 검은색을 띰.","chapter":"3"},{"id":"color-137","cat":"color","term":"셀프 컬러 (self color)","en":"","defn":"솔리드 컬러(solid color), 단일색 몸 전체 모색이 같은 것","chapter":"3"},{"id":"color-138","cat":"color","term":"스모크 (smoke)","en":"","defn":"거무스름한 옅은 흑색의 연기 색","chapter":"3"},{"id":"color-139","cat":"color","term":"스틸 블루 (steel blue)","en":"","defn":"푸른 동색, 청동색.","chapter":"3"},{"id":"color-140","cat":"color","term":"스팟 (spot)","en":"","defn":"반점. 흰색 바탕에 검정이나 리버 스폿이 전신에 무늬. 예) 달마티안","chapter":"3"},{"id":"color-141","cat":"color","term":"슬레이트 블루 (slate blue)","en":"","defn":"검은 회색의 블루, 회색이 있는 청색. 예) 오스트레일리안 실키테리어","chapter":"3"},{"id":"color-142","cat":"color","term":"실버 그레이 (silver gray)","en":"","defn":"마우스 그레이보다 밝은 은색이 도는 회색. 예)와이마리너","chapter":"3"},{"id":"color-143","cat":"color","term":"실버 버프 (silver buff)","en":"","defn":"은색의 하얀색 같은 담황색. 전체적으로 희게 보이며 은색을 띰.","chapter":"3"},{"id":"color-144","cat":"color","term":"실버 블랙 (silver black)","en":"","defn":"검은 털 속에 은색 털이 섞인 것. 예) 스코티시테리어","chapter":"3"},{"id":"color-145","cat":"color","term":"실버 (silver)","en":"","defn":"밝은 회색, 은색.","chapter":"3"},{"id":"color-146","cat":"color","term":"알비노 (albino)","en":"","defn":"선천적 색소 결핍증","chapter":"3"},{"id":"color-147","cat":"color","term":"알비니즘 (albinism)","en":"","defn":"백화 현상, 색소 결핍증. 피부, 털, 눈 등에 색소가 발생하지 않는 이 상 현상. 유전적 원인에 의해 발생함","chapter":"3"},{"id":"color-148","cat":"color","term":"에이프리코트 (apricot)","en":"","defn":"밝은 적황갈색, 살구색","chapter":"3"},{"id":"color-149","cat":"color","term":"옐로 (yellow)","en":"","defn":"노란색. 여우 색부터 크림색까지 범위가 매우 다양함","chapter":"3"},{"id":"color-150","cat":"color","term":"오렌지 (orange)","en":"","defn":"오렌지(orange) ： 오렌지색.","chapter":"3"},{"id":"color-151","cat":"color","term":"울프 그레이 (wolf gray)","en":"","defn":"회색 어두운 정도의 색깔 혼합 비율이 다양함.","chapter":"3"},{"id":"color-152","cat":"color","term":"이사벨라 (isabela)","en":"","defn":"연한 밤색","chapter":"3"},{"id":"color-153","cat":"color","term":"제트 블랙 (jet black)","en":"","defn":"순수한 검은색.","chapter":"3"},{"id":"color-154","cat":"color","term":"체스넛 (chestnut)","en":"","defn":"밤색, 적갈색.","chapter":"3"},{"id":"color-155","cat":"color","term":"초콜릿 (chocolate)","en":"","defn":"초콜릿색, 검은 적갈색","chapter":"3"},{"id":"color-156","cat":"color","term":"카페오레 (cafe au lait)","en":"","defn":"커피 우유색","chapter":"3"},{"id":"color-157","cat":"color","term":"칼라 (collar)","en":"","defn":"목 주변을 감싸는 폭 넓은 흰색 반점. 예) 콜리","chapter":"3"},{"id":"color-158","cat":"color","term":"캡 (cap)","en":"","defn":"캡을 쓴 것 같은 두 개 위의 어두운 반점. 예) 알래스칸맬러뮤트","chapter":"3"},{"id":"color-159","cat":"color","term":"크림 (cream)","en":"","defn":"크림색","chapter":"3"},{"id":"color-160","cat":"color","term":"키스 마크 (kiss mark)","en":"","defn":"검은 모색의 견종의 볼에 있는 진회색 반점. 예) 도베르만핀셔, 로트와일러","chapter":"3"},{"id":"color-161","cat":"color","term":"타이거브린들 (tiger brindle)","en":"","defn":"금색의 바탕색에 호랑이무늬가 있는 것.","chapter":"3"},{"id":"color-162","cat":"color","term":"탠 (tan)","en":"","defn":"황갈색. 짙은 것은 리치 탠, 엷은 것은 라이트 탠이라고 부름","chapter":"3"},{"id":"color-163","cat":"color","term":"트라이컬러 (tri-color)","en":"","defn":"세 가지가 섞인 색. 흰색, 갈색, 검은색","chapter":"3"},{"id":"color-164","cat":"color","term":"트레이스 (trace)","en":"","defn":"폰 색의 등줄기를 따른 검은 선. 예) 퍼그의 등줄기 색","chapter":"3"},{"id":"color-165","cat":"color","term":"티킹 (ticking)","en":"","defn":"흰색 바탕에 한 가지나 두 가지의 명확한 독립적인 반점이 있는 것. 예) 브리타니","chapter":"3"},{"id":"color-166","cat":"color","term":"파울 컬러 (foul color)","en":"","defn":"폴트 컬러(fault color), 부정 모색. 바람직하지 못한 반점이나 모색.","chapter":"3"},{"id":"color-167","cat":"color","term":"파티컬러 (parti-color)","en":"","defn":"두 가지 색의 구분된 반점의 색깔. 보통 흰 바탕에 윤곽이 뚜렷한 갈색 또는 검은색 반점이 있음","chapter":"3"},{"id":"color-168","cat":"color","term":"팰로 (fallow)","en":"","defn":"담황색.","chapter":"3"},{"id":"color-169","cat":"color","term":"페퍼 앤 솔트 (pepper and salt)","en":"","defn":"검은색과 흰색의 혼합","chapter":"3"},{"id":"color-170","cat":"color","term":"페퍼 (pepper)","en":"","defn":"후추 색, 어두운 푸른 계통의 검은색에서 밝은 은회색까지 다양함","chapter":"3"},{"id":"color-171","cat":"color","term":"펜실링 (penciling)","en":"","defn":"맨체스터테리어의 발가락에 있는 검은 선.","chapter":"3"},{"id":"color-172","cat":"color","term":"포인츠 (points)","en":"","defn":"안면, 귀, 사지 및 꼬리의 모색. 보통은 흰색, 검은색, 탠 등임.","chapter":"3"},{"id":"color-173","cat":"color","term":"퓨스 (puce)","en":"","defn":"암갈색","chapter":"3"},{"id":"color-174","cat":"color","term":"피그멘테이션 (pigmentation)","en":"","defn":"피모의 멜라닌 색소 과립 침착 상태.","chapter":"3"},{"id":"color-175","cat":"color","term":"하운드마킹 (hound marking)","en":"","defn":"흰색, 검은색, 황갈색의 반점.","chapter":"3"},{"id":"color-176","cat":"color","term":"할퀸 (harlezuin)","en":"","defn":"흰색 바탕에 검은색이나 그레이의 불규칙한 반점이 있는 것. 순백색 바 탕에 찢긴 것 같은 검은 반점무늬가 있음.","chapter":"3"},{"id":"color-177","cat":"color","term":"허니 (honey)","en":"","defn":"벌꿀 색. 연한 적황갈색","chapter":"3"},{"id":"color-178","cat":"color","term":"화운 (faun)","en":"","defn":"금색에 검은색이 조금 섞은 색.","chapter":"3"},{"id":"color-179","cat":"color","term":"화이트 (white)","en":"","defn":"흰색, 화이트 컬러 종은 눈, 입술, 코, 패드, 항문이 검은색이며 이것으 로 알비노가 아님을 증명함","chapter":"3"},{"id":"color-180","cat":"color","term":"휘튼 (wheaten)","en":"","defn":"옅은 황색의 털, 황색이 스민 것 같이 보이는 색.","chapter":"3"},{"id":"head-181","cat":"head","term":"노즈 브리지 (nose bridge)","en":"","defn":"비량, 사람의 콧등과 같은 부분.","chapter":"4-1"},{"id":"head-182","cat":"head","term":"다운 페이스 (down face)","en":"","defn":"디시 페이스의 반대. 두개에서 코끝 아래쪽으로 경사진 얼굴","chapter":"4-1"},{"id":"head-183","cat":"head","term":"단두형 (短頭型)","en":"","defn":"짧고 넓은 두개.","chapter":"4-1"},{"id":"head-184","cat":"head","term":"돔 헤드 (dome head)","en":"","defn":"애플 헤드와 동일한 의미","chapter":"4-1"},{"id":"head-185","cat":"head","term":"드라이 스컬 (dry skull)","en":"","defn":"얼굴 피부가 밀착해 주름이 없는 얼굴. 클린 헤드와 같은 의미","chapter":"4-1"},{"id":"head-186","cat":"head","term":"디시 페이스 (dish face)","en":"","defn":"접시 모양의 얼굴. 스톱보다 콧대가 높아 옆에서 보면 코가 휘어져 접 시 모양을 띤 것.","chapter":"4-1"},{"id":"head-187","cat":"head","term":"링클 (wrinkle)","en":"","defn":"주름. 앞머리 부분이나 얼굴의 이완된 피부. 예) 바센지의 전두부 주름, 샤페이, 블러드하운드","chapter":"4-1"},{"id":"head-188","cat":"head","term":"몰레라 (molera)","en":"","defn":"치와와 두개의 패임으로 부드러운 부분","chapter":"4-1"},{"id":"head-189","cat":"head","term":"밸런스트 헤드 (balanced head)","en":"","defn":"균형 잡힌 머리, 스톱을 중심으로 머리 부분과 얼굴 부분의 길이가 동일하게 균형 잡힌 것. 예) 고든세터","chapter":"4-1"},{"id":"head-190","cat":"head","term":"블로키 헤드 (blocky head)","en":"","defn":"두부에 각이 지거나 펑퍼짐하게 퍼져 길이에 비해 폭이 매우 넓은 네모난 모양의 각진 머리형. 예） 보스턴테리어","chapter":"4-1"},{"id":"head-191","cat":"head","term":"스니피 페이스 (snipy face)","en":"","defn":"주둥이가 뾰족해 약한 느낌의 얼굴","chapter":"4-1"},{"id":"head-192","cat":"head","term":"스컬 (skull)","en":"","defn":"두개. 앞머리의 후두골, 두정골, 전두골, 측두골 등을 포함한 머리부 뼈 조직","chapter":"4-1"},{"id":"head-193","cat":"head","term":"스톱 (stop)","en":"","defn":"액단. 눈 사이의 패인 부분","chapter":"4-1"},{"id":"head-194","cat":"head","term":"애플 헤드 (apple head)","en":"","defn":"사과 모양의 머리, 뒷머리 부분이 부풀어 올라 있는 모양. 예） 치와와","chapter":"4-1"},{"id":"head-195","cat":"head","term":"옥시풋 (occiput)","en":"","defn":"후두부 뒷부분, 양 귀 사이의 주먹 모양의 뼈","chapter":"4-1"},{"id":"head-196","cat":"head","term":"와안 (frog face)","en":"","defn":"개구리 모양 얼굴. 아래턱이 들어가고 코가 돌출된 얼굴. 오버숏이 됨","chapter":"4-1"},{"id":"head-197","cat":"head","term":"장두형 (長頭型)","en":"","defn":"길고 좁은 형태의 머리.","chapter":"4-1"},{"id":"head-198","cat":"head","term":"전안부 (fore face)","en":"","defn":"두부의 앞면으로 눈에서 앞쪽, 주둥이 부위","chapter":"4-1"},{"id":"head-199","cat":"head","term":"중두형 (中頭型)","en":"","defn":"길이와 폭이 중간 정도의 두개","chapter":"4-1"},{"id":"head-200","cat":"head","term":"치즐드 (chiselled)","en":"","defn":"눈 아래가 건조하고 살집이 없어 윤곽이 도드라지는 형태의 얼굴","chapter":"4-1"},{"id":"head-201","cat":"head","term":"치키 (cheeky)","en":"","defn":"볼이 발달해서 팽창되고 불거진 얼굴, 발달이 현저해서 둥근 느낌을 주거나 근육이 두껍게 발달된 것, 얼굴뼈가 돌출된 것. 스탠포드셔 불테리어에 한해 바람직한 표현임","chapter":"4-1"},{"id":"head-202","cat":"head","term":"크라운 (crown)","en":"","defn":"두부의 가장 높은 정수리 부분. 두정부, 톱 스컬 （top skull） 이라고 함","chapter":"4-1"},{"id":"head-203","cat":"head","term":"클린 헤드 (clean head)","en":"","defn":"주름이 없고 앙상한 머리형. 예） 살루키","chapter":"4-1"},{"id":"head-204","cat":"head","term":"타입 오브 스컬 (type of skull)","en":"","defn":"두개（頭蓋）의 타입","chapter":"4-1"},{"id":"head-205","cat":"head","term":"투 앵글드 헤드 (two angled head)","en":"","defn":"옆에서 보았을 때 두개면과 주둥이의 평면이 평행하지 않고 각도가 있는 것","chapter":"4-1"},{"id":"head-206","cat":"head","term":"퍼로 (furrow)","en":"","defn":"세로 주름. 스컬 중앙에서 스톱 방향으로 세로로 가로지르는 이마 부분의 주름.","chapter":"4-1"},{"id":"head-207","cat":"head","term":"페어 셰이프트 헤드 (pear-shaped head)","en":"","defn":"서양배 형의 머리. 예） 베들링턴테리어","chapter":"4-1"},{"id":"head-208","cat":"head","term":"폭시 (foxy)","en":"","defn":"전안부가 짧고 코끝이 뾰족한 것. 여우의 표정을 띠는 것. 예） 포메라니안","chapter":"4-1"},{"id":"head-209","cat":"head","term":"플랫 스컬 (flat skull)","en":"","defn":"앞이나 옆에서 보아서 평평한 두 개. 예） 에어데일테리어, 스탠더드 슈나우저","chapter":"4-1"},{"id":"eye-210","cat":"eye","term":"라운드 아이 (round eye)","en":"","defn":"동그란 눈. 예) 몰티즈","chapter":"4-2"},{"id":"eye-211","cat":"eye","term":"마블 아이 (marble eye)","en":"","defn":"대리석 색상의 눈. 예) 블루멀콜리나 웰시코기카디건","chapter":"4-2"},{"id":"eye-212","cat":"eye","term":"벌징 아이 (bulging eye)","en":"","defn":"튀어나와 볼록하게 보이는 눈","chapter":"4-2"},{"id":"eye-213","cat":"eye","term":"아몬드 아이 (almond eye)","en":"","defn":"아몬드 모양 눈. 눈 양끝이 뾰족한 아몬드 모양의 눈. 예) 저먼셰퍼드, 도베르만핀셔","chapter":"4-2"},{"id":"eye-214","cat":"eye","term":"아이 스테인 (eye stain)","en":"","defn":"눈물자국.","chapter":"4-2"},{"id":"eye-215","cat":"eye","term":"아이라인 (eye line)","en":"","defn":"눈꺼풀 가장자리.","chapter":"4-2"},{"id":"eye-216","cat":"eye","term":"아이리드 (eyelid)","en":"","defn":"눈꺼풀.","chapter":"4-2"},{"id":"eye-217","cat":"eye","term":"오벌 아이 (oval eye)","en":"","defn":"일반적인 모양의 타원형, 계란형 눈. 예) 푸들, 살루키","chapter":"4-2"},{"id":"eye-218","cat":"eye","term":"차이나 아이 (china eye)","en":"","defn":"밝은 청색의 눈. 마루색 유전자를 가진 견종에게서 나타나는 불완전한 눈. 보통은 결점으로 간주되나 모색과 관계해 허용되는 견종도 있음. 예) 시베리안 허스키, 블루멀콜리나 웰시코기카디건","chapter":"4-2"},{"id":"eye-219","cat":"eye","term":"트라이앵글러 아이 (triangular eye)","en":"","defn":"눈꺼풀의 바깥쪽이 올라가 삼각형 모양을 이루는 눈. 예) 아프간하운드","chapter":"4-2"},{"id":"eye-220","cat":"eye","term":"풀 아이 (full eye)","en":"","defn":"둥글게 튀어나온 눈.","chapter":"4-2"},{"id":"mouth-221","cat":"mouth","term":"결치","en":"","defn":"선천적으로 정상 치아 수에 비해 치아 수가 없는 것. 단두종에게 많음. 제1 전구치에 많이 발생함","chapter":"4-3"},{"id":"mouth-222","cat":"mouth","term":"과리치","en":"","defn":"결치의 반대말. 표준 치아 수보다 많은 것.","chapter":"4-3"},{"id":"mouth-223","cat":"mouth","term":"라이 마우스 (wry mouth)","en":"","defn":"뒤틀려 삐뚤어진 입","chapter":"4-3"},{"id":"mouth-224","cat":"mouth","term":"리피 (lippy)","en":"","defn":"아래로 늘어진 입술, 턱이 밀착되지 않은 입술","chapter":"4-3"},{"id":"mouth-225","cat":"mouth","term":"머즐 (muzzle)","en":"","defn":"주둥이. 입. 얼굴부","chapter":"4-3"},{"id":"mouth-226","cat":"mouth","term":"부정 교합","en":"","defn":"견종 표준이 요구하는 교합 외의 교합.","chapter":"4-3"},{"id":"mouth-227","cat":"mouth","term":"손상치","en":"","defn":"후천적으로 파손된 치아","chapter":"4-3"},{"id":"mouth-228","cat":"mouth","term":"스니피 머즐 (snipy muzzle)","en":"","defn":"날카롭고 좁으며 뾰족한 주둥이","chapter":"4-3"},{"id":"mouth-229","cat":"mouth","term":"시저스 바이트 (scissors bite)","en":"","defn":"협상 교합. 위턱 앞니와 아래턱 앞니가 조금 접촉되어 맞물린 것","chapter":"4-3"},{"id":"mouth-230","cat":"mouth","term":"실치","en":"","defn":"후천적으로 상실한 치아.","chapter":"4-3"},{"id":"mouth-231","cat":"mouth","term":"언더숏 (undershot)","en":"","defn":"반대 교합. 아래턱 전출. 아래턱 앞니가 위턱 앞니보다 앞쪽으로 돌출 되어 맞물린 것.","chapter":"4-3"},{"id":"mouth-232","cat":"mouth","term":"오버숏 (overshot)","en":"","defn":"과리 교합. 위턱의 앞니가 아래턱 앞니보다 전방으로 돌출되어 맞물린 것","chapter":"4-3"},{"id":"mouth-233","cat":"mouth","term":"이븐 바이트 (even bite)","en":"","defn":"절단 교합. 위턱과 아래턱이 맞물린 것","chapter":"4-3"},{"id":"mouth-234","cat":"mouth","term":"정상 교합","en":"","defn":"견종 표준에서 요구하는 교합","chapter":"4-3"},{"id":"mouth-235","cat":"mouth","term":"조 (jaw)","en":"","defn":"턱","chapter":"4-3"},{"id":"mouth-236","cat":"mouth","term":"조율 (jowel)","en":"","defn":"두터운 입술과 턱. 촙과 같은 말","chapter":"4-3"},{"id":"mouth-237","cat":"mouth","term":"촙 (chop)","en":"","defn":"두터운 입술과 턱 예） 불도그","chapter":"4-3"},{"id":"mouth-238","cat":"mouth","term":"치아의 수","en":"","defn":"• 개의 유치: 28개\n• 생후 3~4주경에 절치, 견치, 구치의 순서로 나오기 시작해 생후 6주 정도에 모두 완성.\n• 절치(앞니, 문치, incisor teeth) 6개, 견치(송곳니, canine tooth) 2개, 구치(어금니, molar tooth) 6개\n• 어른 견의 영구치: 42개\n• 생후 4~8개월이 되면 유치의 치근이 융해되면서 영구치가 유치를 밀어내어 빠지고 이갈이를 하는데 7~8개월쯤이면 거의 모두 영구치로 바뀜. 영양 상태가 좋지 않거나 단두종의 경우 다소 늦을 수 있음. 전구치와 후구치는 유치 없이 나옴.\n• 윗니 20개: 절치(앞니, 문치, incisor teeth) 3개, 견치(송곳니, canine tooth) 1개, 전구치(어금니, 소구치, molar tooth) 4개, 후구치(어금니, 대구치, molar tooth) 2개가 좌우로 위치함.\n• 아랫니 22개: 절치(앞니, 문치 incisor teeth) 3개, 견치(송곳니, canine tooth) 1개, 전구치(어금니, 소구치, molar tooth) 4개, 후구치(어금니, 대구치, molar tooth) 3개가 좌우로 위치함.","chapter":"4-3"},{"id":"mouth-239","cat":"mouth","term":"쿠션 (cushion)","en":"","defn":"윗입술이 두껍고 풍만한 것. 예） 페키니즈","chapter":"4-3"},{"id":"mouth-240","cat":"mouth","term":"템퍼치","en":"","defn":"디스템퍼나 고열에 의해 변화되어 변색된 치아","chapter":"4-3"},{"id":"mouth-241","cat":"mouth","term":"플루즈 (flews)","en":"","defn":"늘어진 윗입술","chapter":"4-3"},{"id":"mouth-242","cat":"mouth","term":"피그 조 (pig jaw)","en":"","defn":"과도한 오버숏.","chapter":"4-3"},{"id":"nose-243","cat":"nose","term":"노즈 밴드 (nose band)","en":"","defn":"주둥이를 둘러싼 흰색의 띠를 이룬 반점","chapter":"4-4"},{"id":"nose-244","cat":"nose","term":"노즈 브리지 (nose bridge)","en":"","defn":"스톱에서 코까지 주둥이 면. 코 근육","chapter":"4-4"},{"id":"nose-245","cat":"nose","term":"더들리 노즈 (dudley nose)","en":"","defn":"색소가 부족한 살빛의 코, 빨간 코","chapter":"4-4"},{"id":"nose-246","cat":"nose","term":"로만 노즈 (roman nose)","en":"","defn":"독수리 코. 매부리코. 예） 보르조이","chapter":"4-4"},{"id":"nose-247","cat":"nose","term":"리버 노즈 (liver nose)","en":"","defn":"간장 색 코.","chapter":"4-4"},{"id":"nose-248","cat":"nose","term":"버터플라이 노즈 (butterfly nose)","en":"","defn":"반점 모양의 코. 살색 코에 검은 반점이 있거나 검은 코에 살색 반점 이 있는 것","chapter":"4-4"},{"id":"nose-249","cat":"nose","term":"스노 노즈 (snow nose)","en":"","defn":"평소에는 코가 검은색이나 겨울철에 핑크색 줄무늬가 생기는 코.","chapter":"4-4"},{"id":"nose-250","cat":"nose","term":"프레시 노즈 (fresh nose)","en":"","defn":"살색 코","chapter":"4-4"},{"id":"ear-251","cat":"ear","term":"드롭 이어 (drop ear)","en":"","defn":"아래로 늘어진 귀. 예） 바셋하운드","chapter":"4-5"},{"id":"ear-252","cat":"ear","term":"로즈 이어 (rose ear)","en":"","defn":"귀의 안쪽이 보이며 뒤틀려 작게 늘어진 귀. 예） 불도그, 휘핏","chapter":"4-5"},{"id":"ear-253","cat":"ear","term":"배트 이어 (bat ear)","en":"","defn":"귀 아랫부분이 넓고 박쥐 날개같이 둥글게 선 귀. 예） 프렌치불도그, 웰시코기","chapter":"4-5"},{"id":"ear-254","cat":"ear","term":"버터플라이 이어 (butterfly ear)","en":"","defn":"나비 모양 귀, 긴 장식 털에 서 있는 큰 귀가 두개 바깥쪽으로 약 45° 기운 나비 모양 귀. 예） 파피용","chapter":"4-5"},{"id":"ear-255","cat":"ear","term":"버튼 이어 (button ear)","en":"","defn":"아래 부위는 직립해 있고 귓불이 두개 앞쪽으로 v 모양으로 늘어진 귀. 예） 보더테리어, 폭스테리어","chapter":"4-5"},{"id":"ear-256","cat":"ear","term":"벨 이어 (bell ear)","en":"","defn":"종 모양의 귀. 끝이 둥근 벨과 같은 형태의 둥근 귀","chapter":"4-5"},{"id":"ear-257","cat":"ear","term":"V형 귀 (V-shaped ear)","en":"","defn":"삼각형 모양의 귀, 늘어진 귀와 선 귀 두 가지 타입이 있음. 예） 불마스티프, 에어데일테리어（늘어진 귀）, 시베리안허스키（선 귀）","chapter":"4-5"},{"id":"ear-258","cat":"ear","term":"세미프릭 이어 (semiprick ear)","en":"","defn":"반직립형 귀. 직립한 귀의 끝부분이 앞으로 기울어진 것. 예） 폭스테리어, 러프콜리, 그레이하운드","chapter":"4-5"},{"id":"ear-259","cat":"ear","term":"이렉트 (erect)","en":"","defn":"귀나 꼬리를 위쪽으로 세운 것","chapter":"4-5"},{"id":"ear-260","cat":"ear","term":"이어 프린지 (ear fringe)","en":"","defn":"길게 늘어진 귀 주변의 장식 털. 예） 세터","chapter":"4-5"},{"id":"ear-261","cat":"ear","term":"캔들 프레임 이어 (candle flame ear)","en":"","defn":"촛불 모양의 귀. 예） 잉글리시토이테리어","chapter":"4-5"},{"id":"ear-262","cat":"ear","term":"크롭트 이어 (cropped ear)","en":"","defn":"귀를 세우기 위해 자른（크로핑- cropping） 귀. 예） 복서, 도베르만핀셔","chapter":"4-5"},{"id":"ear-263","cat":"ear","term":"파렌 이어 (phalene ear)","en":"","defn":"늘어진 귀 타입. 파피용의 늘어진 타입은 그 수가 매우 적음. 틀어진 타입의 파피용의 경우 완전하게 늘어져야만 함.","chapter":"4-5"},{"id":"ear-264","cat":"ear","term":"펜던트 이어 (pendant ear)","en":"","defn":"늘어진 귀. 예） 닥스훈트, 바셋하운드","chapter":"4-5"},{"id":"ear-265","cat":"ear","term":"프릭 이어 (prick ear)","en":"","defn":"직립 귀, 앞쪽 끝부분이 뾰족하게 선 귀. 귀를 잘라 인위적으로 만든 직립 귀와 자연적인 직립 귀가 있음. 예） 저먼셰퍼드（자연적인 직립 귀）, 도베르만핀셔, 복서, 그레이트데인（귀를 잘라 세운 귀）","chapter":"4-5"},{"id":"ear-266","cat":"ear","term":"플레어링 이어 (flaring ear)","en":"","defn":"나팔꽃 모양 귀. 예） 치와와","chapter":"4-5"},{"id":"ear-267","cat":"ear","term":"필버트 타입 이어 (fillbert shaped ear)","en":"","defn":"개암나무 열매 형태의 귀. 예） 베들링턴테리어","chapter":"4-5"},{"id":"ear-268","cat":"ear","term":"하이셋 이어 (highset ear)","en":"","defn":"높은 위치에 귀가 있는 것. 반대로 낮은 위치에 귀가 있는 것은 로셋 이어 （lowset ear） 라고 함.","chapter":"4-5"},{"id":"body-269","cat":"body","term":"구스 럼프 (goose rump)","en":"","defn":"근육 발달이 불충분해 엉덩이 골반의 경사가 급한 것. 보통 꼬리가 낮게 자리 잡음.","chapter":"4-6"},{"id":"body-270","cat":"body","term":"다운힐 (downhill)","en":"","defn":"등선이 허리로 갈수록 낮아지는 모양","chapter":"4-6"},{"id":"body-271","cat":"body","term":"듀클로 (dewclaw)","en":"","defn":"다리 안쪽 엄지발톱. 낭조. 며느리발톱","chapter":"4-6"},{"id":"body-272","cat":"body","term":"럼프 (rump)","en":"","defn":"엉덩이. 골반 상부의 근육이 연결된 부위","chapter":"4-6"},{"id":"body-273","cat":"body","term":"레벨 백 (level back)","en":"","defn":"수평한 등. 기갑에서 허리에 걸쳐 평편한 모양. 바람직한 등의 모양.","chapter":"4-6"},{"id":"body-274","cat":"body","term":"레이시 (racy)","en":"","defn":"껑충하게 긴 다리. 등이 높고 비교적 가는 체구의 몸통 타입. 균형 잡히고 세련된 모양","chapter":"4-6"},{"id":"body-275","cat":"body","term":"레인지 (rangy)","en":"","defn":"흉심이 얕은 긴 몸통의 타입","chapter":"4-6"},{"id":"body-276","cat":"body","term":"로인 (loin)","en":"","defn":"허리, 요부.","chapter":"4-6"},{"id":"body-277","cat":"body","term":"로치 백 (roach back)","en":"","defn":"잉어 등. 등선이 허리로 향하여 부드럽게 커드한 모양.","chapter":"4-6"},{"id":"body-278","cat":"body","term":"롱 바디 (long body)","en":"","defn":"긴 몸통. 예) 닥스훈트","chapter":"4-6"},{"id":"body-279","cat":"body","term":"리브 (rib)","en":"","defn":"늑골. 갈비뼈. 13대로 흉추에 연결됨.","chapter":"4-6"},{"id":"body-280","cat":"body","term":"리브케이지 (ribcage)","en":"","defn":"흉곽. 심장이나 폐 등을 수용하는 바구니 형태의 골격","chapter":"4-6"},{"id":"body-281","cat":"body","term":"바디 (body)","en":"","defn":"몸통","chapter":"4-6"},{"id":"body-282","cat":"body","term":"배럴 체스트 (barrel chest)","en":"","defn":"술통 모양의 가슴.","chapter":"4-6"},{"id":"body-283","cat":"body","term":"백 라인 (back line)","en":"","defn":"등선. 기갑에서 시작해 꼬리 뿌리 부분까지의 등선","chapter":"4-6"},{"id":"body-284","cat":"body","term":"백 (back)","en":"","defn":"등","chapter":"4-6"},{"id":"body-285","cat":"body","term":"버톡 (buttock)","en":"","defn":"엉덩이","chapter":"4-6"},{"id":"body-286","cat":"body","term":"보시 (bossy)","en":"","defn":"어깨 근육이 과도하게 발달해 두꺼운 몸통 타입.","chapter":"4-6"},{"id":"body-287","cat":"body","term":"브리스킷 (brisket)","en":"","defn":"하흉부. 몸통 앞쪽의 가슴 아랫부분","chapter":"4-6"},{"id":"body-288","cat":"body","term":"비피 (beefy)","en":"","defn":"근육이나 살이 과도하게 발달해 비만인 몸통 타입.","chapter":"4-6"},{"id":"body-289","cat":"body","term":"쇼트 백 (short back)","en":"","defn":"기갑의 높이보다 짧은 등","chapter":"4-6"},{"id":"body-290","cat":"body","term":"쇼트커플드 (short-coupled)","en":"","defn":"라스트 리브에서 둔부까지 거리가 짧은 것.","chapter":"4-6"},{"id":"body-291","cat":"body","term":"숄더 (shoulder)","en":"","defn":"어깨","chapter":"4-6"},{"id":"body-292","cat":"body","term":"스웨이 백 (sway back)","en":"","defn":"캐멀 백의 반대. 등선이 움푹 파인 모양","chapter":"4-6"},{"id":"body-293","cat":"body","term":"스트레이트 숄더 (straight shoulder)","en":"","defn":"어깨 전출. 어깨가 전방으로 기울어짐","chapter":"4-6"},{"id":"body-294","cat":"body","term":"슬로핑 숄더 (sloping shoulder)","en":"","defn":"견갑골이 뒤쪽으로 길게 경사를 이루어 후방으로 경사진 어깨","chapter":"4-6"},{"id":"body-295","cat":"body","term":"아웃 오브 숄더 (out of shoulder)","en":"","defn":"전구가 매우 넓어진 상태. 두드러지게 벌어진 어깨. 예) 불도그","chapter":"4-6"},{"id":"body-296","cat":"body","term":"앵귤레이션 (angulation)","en":"","defn":"뼈와 뼈가 연결되는 각도","chapter":"4-6"},{"id":"body-297","cat":"body","term":"언더 라인 (under line)","en":"","defn":"가슴 아랫부분에서 배를 따라 만들어진 아랫면의 윤곽선.","chapter":"4-6"},{"id":"body-298","cat":"body","term":"에이너스 (anus)","en":"","defn":"항문","chapter":"4-6"},{"id":"body-299","cat":"body","term":"오벌 체스트 (oval chest)","en":"","defn":"계란 모양의 가슴.","chapter":"4-6"},{"id":"body-300","cat":"body","term":"위더스 (withers)","en":"","defn":"기갑. 목 아래에 있는 어깨의 가장 높은 점. 키를 이 위치에서 측정.","chapter":"4-6"},{"id":"body-301","cat":"body","term":"위디 (weedy)","en":"","defn":"골량 부족으로 가느다란 모양. 골격이 가늘고 외소한 모양. 미발육의 신체 상태.","chapter":"4-6"},{"id":"body-302","cat":"body","term":"인 숄더 (in shoulder)","en":"","defn":"등뼈와 평행하지 않은 어깨 끝. 어깨가 앞으로 나온 모양.","chapter":"4-6"},{"id":"body-303","cat":"body","term":"체스트 (chest)","en":"","defn":"가슴. 흉부","chapter":"4-6"},{"id":"body-304","cat":"body","term":"캐멀 백 (camel back)","en":"","defn":"낙타 등. 어깨 쪽이 낮고 허리 부분이 둥글게 올라가고 엉덩이가 내려간 모양","chapter":"4-6"},{"id":"body-305","cat":"body","term":"캣 풋 (cat foot)","en":"","defn":"고양이 발.","chapter":"4-6"},{"id":"body-306","cat":"body","term":"커플링 (coupling)","en":"","defn":"요부. 늑골과 관골 사이를 연결하는 몸통 부위. 흉부와 엉덩이의 중간 부위.","chapter":"4-6"},{"id":"body-307","cat":"body","term":"코비 (cobby)","en":"","defn":"몸통이 짧고 간결한 모양의 몸통 타입. 예) 몰티즈","chapter":"4-6"},{"id":"body-308","cat":"body","term":"크루프 (croup)","en":"","defn":"엉덩이.","chapter":"4-6"},{"id":"body-309","cat":"body","term":"클로디 (cloddy)","en":"","defn":"등이 낮고 몸통이 굵어 무겁게 느껴지는 몸통의 타입","chapter":"4-6"},{"id":"body-310","cat":"body","term":"턱 업 (tuck up)","en":"","defn":"허리 부분에서 복부가 감싸 올려진 상태.","chapter":"4-6"},{"id":"body-311","cat":"body","term":"톱 라인 (top line)","en":"","defn":"기갑 직후부터 뿌리까지의 등선.","chapter":"4-6"},{"id":"body-312","cat":"body","term":"파텔라 (patella)","en":"","defn":"슬개골","chapter":"4-6"},{"id":"body-313","cat":"body","term":"페이퍼 풋 (paper foot)","en":"","defn":"종이발. 발바닥이 너무 얇아 움직임이 빈약함","chapter":"4-6"},{"id":"body-314","cat":"body","term":"플랭크 (flank)","en":"","defn":"옆구리. 라스트 리브와 엉덩이 사이의 몸통 측면","chapter":"4-6"},{"id":"body-315","cat":"body","term":"헤어 풋 (hare foot)","en":"","defn":"토끼발. 긴 발가락","chapter":"4-6"},{"id":"body-316","cat":"body","term":"흉심","en":"","defn":"가슴의 깊이. 기갑부 최고점에서 가슴 아래에 이르는 수직 거리.","chapter":"4-6"},{"id":"body-317","cat":"body","term":"힙 본 (hip bone)","en":"","defn":"관골. 장골, 좌골, 치골로 이루어지며 고관절을 형성함. 장골이 가장 큼.","chapter":"4-6"},{"id":"body-318","cat":"body","term":"힙 조인트 (hip joint)","en":"","defn":"고관절.","chapter":"4-6"},{"id":"leg-319","cat":"leg","term":"내로 사이 (narrow thigh)","en":"","defn":"폭이 좁은 대퇴부.","chapter":"4-7"},{"id":"leg-320","cat":"leg","term":"내로 프런트 (narrow front)","en":"","defn":"앞가슴 폭이 좁은 프런트. 앞다리 간격이 좁음. 예) 보르조이","chapter":"4-7"},{"id":"leg-321","cat":"leg","term":"다운 인 패스턴 (down inpastern)","en":"","defn":"패스턴이 앞쪽으로 경사진 것. 지구력이 결여되어 결점","chapter":"4-7"},{"id":"leg-322","cat":"leg","term":"배럴 호크 (barrel hock)","en":"","defn":"발가락 부분이 안쪽으로 굽어 밖으로 돌아간 비절","chapter":"4-7"},{"id":"leg-323","cat":"leg","term":"보우드 프런트 (bowed front)","en":"","defn":"활 모양의 전반부. 팔꿈치가 바깥쪽으로 굽은 안짱다리.","chapter":"4-7"},{"id":"leg-324","cat":"leg","term":"사이 (thigh)","en":"","defn":"어퍼 사이(upper thigh) 대퇴부. 후지 엉덩이에서 무릎 관절까지의 부위.","chapter":"4-7"},{"id":"leg-325","cat":"leg","term":"세컨드 사이 (second thigh)","en":"","defn":"로어 사이(lower thigh) 하퇴부. 후지 무릎 관절부터 비절까지의 부위.","chapter":"4-7"},{"id":"leg-326","cat":"leg","term":"스타이플 (stifle)","en":"","defn":"무릎 관절. 대퇴골과 하퇴골을 연결하는 부위","chapter":"4-7"},{"id":"leg-327","cat":"leg","term":"스트레이트 프런트 (straight front)","en":"","defn":"테리어의 프런트. 일직선상의 프런트.","chapter":"4-7"},{"id":"leg-328","cat":"leg","term":"스트레이트 호크 (straight hock)","en":"","defn":"각도가 없는 관절","chapter":"4-7"},{"id":"leg-329","cat":"leg","term":"스팁 프런트 (steep front)","en":"","defn":"어깨가 높아서 깎아지는 듯한 프런트","chapter":"4-7"},{"id":"leg-330","cat":"leg","term":"시클 호크 (sickle hock)","en":"","defn":"비절이 낮아 낫 모양 관절.","chapter":"4-7"},{"id":"leg-331","cat":"leg","term":"아웃 앳 엘보 (out at elbow)","en":"","defn":"팔꿈치가 밖으로 돈 것.","chapter":"4-7"},{"id":"leg-332","cat":"leg","term":"어퍼 암 (upper arm)","en":"","defn":"상완부.","chapter":"4-7"},{"id":"leg-333","cat":"leg","term":"엘보 (elbow)","en":"","defn":"팔꿈치.","chapter":"4-7"},{"id":"leg-334","cat":"leg","term":"와이드 프런트 (wide front)","en":"","defn":"앞발 간격이 넓은 프런트. 예) 불도그","chapter":"4-7"},{"id":"leg-335","cat":"leg","term":"웰 벤트 호크 (well bent hock)","en":"","defn":"이상적인 각도의 비절.","chapter":"4-7"},{"id":"leg-336","cat":"leg","term":"카우 호크 (cow hock)","en":"","defn":"뒷다리 양쪽이 소처럼 안쪽으로 구부러진 다리","chapter":"4-7"},{"id":"leg-337","cat":"leg","term":"트위스팅 호크 (twisting hock)","en":"","defn":"체중이 과도해 지탱이 어려워 좌우 비절 관절이 염전된 것.","chapter":"4-7"},{"id":"leg-338","cat":"leg","term":"패스턴 (pastern)","en":"","defn":"중수골. 손의 관절과 손가락 뼈 사이의 부위. 앞다리의 가운데 뼈. 뒷다 리의 가운데 뼈.","chapter":"4-7"},{"id":"leg-339","cat":"leg","term":"포어 암 (fore arm)","en":"","defn":"전완부","chapter":"4-7"},{"id":"leg-340","cat":"leg","term":"프런트 (front)","en":"","defn":"앞다리, 앞가슴, 가슴, 어깨 목 등을 포함한 개 전반부","chapter":"4-7"},{"id":"leg-341","cat":"leg","term":"피들 프런트 (fiddle front)","en":"","defn":"팔꿈치가 바깥쪽으로 굽은 프런트. 발가락도 밖으로 향함","chapter":"4-7"},{"id":"leg-342","cat":"leg","term":"호크 (hock)","en":"","defn":"비절. 아랫다리와 패스턴 사이의 뒷다리 관절.","chapter":"4-7"},{"id":"tail-343","cat":"tail","term":"게이 테일 (gay tail)","en":"","defn":"치켜든 꼬리. 예） 스코티시테리어","chapter":"4-8"},{"id":"tail-344","cat":"tail","term":"독 (dock)","en":"","defn":"잘린 꼬리. 단미. 보통 생후 4~7일에 실시","chapter":"4-8"},{"id":"tail-345","cat":"tail","term":"랫 테일 (rat tail)","en":"","defn":"쥐꼬리 모양. 뿌리 부분이 두텁고 부드러운 털이 있는 반면 끝 쪽에는 털이 없고 가는 꼬리 예） 아이리시워터스패니얼","chapter":"4-8"},{"id":"tail-346","cat":"tail","term":"로셋 테일 (low set tail)","en":"","defn":"낮게 달린 꼬리.","chapter":"4-8"},{"id":"tail-347","cat":"tail","term":"링 테일 (ring tail)","en":"","defn":"커브진 꼬리. 바퀴 모양으로 꼬리 뿌리가 높게 올려져 원형을 이루는 꼬리. 예) 아프간하운드","chapter":"4-8"},{"id":"tail-348","cat":"tail","term":"밥 테일 (bob tail)","en":"","defn":"선천적으로 꼬리가 없는 것, 또는 잘린 꼬리","chapter":"4-8"},{"id":"tail-349","cat":"tail","term":"브러시 테일 (brush tail)","en":"","defn":"여우처럼 길고 늘어진 둥근 브러시 모양의 꼬리. 폭스 브렛슈라고도 함. 예） 시베리안허스키","chapter":"4-8"},{"id":"tail-350","cat":"tail","term":"세이버 테일 (saver tail)","en":"","defn":"바셋하운드처럼 부드럽게 커브를 그리며 올라간 형태와 저먼셰퍼드처럼 반원형을 이루며 낮게 유지한 두 가지 형태가 있음.","chapter":"4-8"},{"id":"tail-351","cat":"tail","term":"셋온 (set-on)","en":"","defn":"꼬리와 몸통의 연결점. 꼬리의 뿌리 부분","chapter":"4-8"},{"id":"tail-352","cat":"tail","term":"스냅 테일 (snap tail)","en":"","defn":"낫 모양 꼬리. 꼬리 끝이 등에 접촉된 꼬리. 예） 알래스칸맬러뮤트","chapter":"4-8"},{"id":"tail-353","cat":"tail","term":"스쿼럴 테일 (squirrel tail)","en":"","defn":"다람쥐 꼬리. 예） 파피용.","chapter":"4-8"},{"id":"tail-354","cat":"tail","term":"스크루 테일 (screw tail)","en":"","defn":"와인 오프너 같은 모양의 나선형 꼬리. 예） 불도그, 보스턴테리어","chapter":"4-8"},{"id":"tail-355","cat":"tail","term":"스턴 (stern)","en":"","defn":"하운드나 테리어종 중 짧은 꼬리의 경우. 예） 폭스테리어","chapter":"4-8"},{"id":"tail-356","cat":"tail","term":"시클 테일 (sickle tail)","en":"","defn":"낫 모양 꼬리. 뿌리부터 등 위로 높게 자리 잡고 중간에 반원형을 그리며 낫 모양으로 구부러진 꼬리","chapter":"4-8"},{"id":"tail-357","cat":"tail","term":"오터 테일 (otter tail)","en":"","defn":"수달 꼬리 모양. 뿌리 부분이 두껍고 둥글며 끝은 가는 꼬리. 예） 래브라도리트리버","chapter":"4-8"},{"id":"tail-358","cat":"tail","term":"이렉트 테일 (erect tail)","en":"","defn":"직립 꼬리. 위를 향해 선 꼬리. 예） 스코티시테리어, 폭스테리어","chapter":"4-8"},{"id":"tail-359","cat":"tail","term":"컬드 테일 (curled tail)","en":"","defn":"심하게 말려 올라가 등 가운데 짊어진 꼬리 예） 페키니즈","chapter":"4-8"},{"id":"tail-360","cat":"tail","term":"콕트업 테일 (cocked-up tail)","en":"","defn":"등선에 직각으로 구부러져 올려진 꼬리.","chapter":"4-8"},{"id":"tail-361","cat":"tail","term":"크랭크 테일 (crank tail)","en":"","defn":"굴곡진 꼬리. 짧고 아래를 향한 꼬리로 말단이 위쪽으로 꼬부라짐. 예） 불도그","chapter":"4-8"},{"id":"tail-362","cat":"tail","term":"크룩 테일 (crook tail)","en":"","defn":"구부러진 꼬리.","chapter":"4-8"},{"id":"tail-363","cat":"tail","term":"킹크 테일 (kink tail)","en":"","defn":"비틀린 꼬리. 예） 프렌치불도그","chapter":"4-8"},{"id":"tail-364","cat":"tail","term":"테일 (tail)","en":"","defn":"꼬리","chapter":"4-8"},{"id":"tail-365","cat":"tail","term":"테일리스 (tailless)","en":"","defn":"꼬리가 없는 것, 선천적으로 꼬리가 없는 경우","chapter":"4-8"},{"id":"tail-366","cat":"tail","term":"판 테일 (fan tail)","en":"","defn":"풍부한 모량의 장모 꼬리를 등위로 말아 올리고 있거나 부채를 편 것 같은 형태의 꼬리. 예） 포메라니안","chapter":"4-8"},{"id":"tail-367","cat":"tail","term":"플래그 테일 (flag tail)","en":"","defn":"깃발 형태의 꼬리. 예） 잉글리시세터","chapter":"4-8"},{"id":"tail-368","cat":"tail","term":"플래그폴 테일 (flagpoles tail)","en":"","defn":"등선에 대해 직각으로 올라간 꼬리. 예） 비글","chapter":"4-8"},{"id":"tail-369","cat":"tail","term":"플룸 테일 (plume tail)","en":"","defn":"깃털 모양의 장식 털이 아래로 늘어진 꼬리. 예） 잉글리시세터","chapter":"4-8"},{"id":"tail-370","cat":"tail","term":"하이셋 테일 (high set tail)","en":"","defn":"높게 달린 꼬리","chapter":"4-8"},{"id":"tail-371","cat":"tail","term":"훅 테일 (hook tail)","en":"","defn":"갈고리 모양 꼬리. 예） 브리아드, 피레니언마운틴도그","chapter":"4-8"},{"id":"tail-372","cat":"tail","term":"휩 테일 (whip tail)","en":"","defn":"채찍형 꼬리. 곧고 길며 끝이 가늘고 뾰족한 꼬리. 예） 잉글리시포인터","chapter":"4-8"}]
